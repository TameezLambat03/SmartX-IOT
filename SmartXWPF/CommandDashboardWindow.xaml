<Window x:Class="SmartXWPF.CommandDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | Command Stream and History"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#101418">

    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#20282D"/>
            <Setter Property="Foreground" Value="#8E9AA3"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderBrush" Value="#2B363D"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SMART-X"
                           Foreground="#20C997"
                           FontSize="14"
                           FontWeight="Bold"/>

                <TextBlock Text="Real-Time Command Stream"
                           Foreground="#F1F5F7"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="Device control, telemetry alerts and command history"
                           Foreground="#8E9AA3"
                           FontSize="13"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="‹ MAIN MENU"
                    Click="BtnMainMenu_Click"
                    Padding="16,10"
                    VerticalAlignment="Center"
                    Background="#1D252B"
                    Foreground="#F1F5F7"
                    BorderBrush="#2B363D"
                    Cursor="Hand"/>
        </Grid>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,20">

            <Border Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="REGISTERED DEVICES"
                               Foreground="#8E9AA3"
                               FontSize="11"/>

                    <TextBlock x:Name="LblDeviceCount"
                               Text="—"
                               Foreground="#F1F5F7"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="5,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE ALERTS"
                               Foreground="#8E9AA3"
                               FontSize="11"/>

                    <TextBlock x:Name="LblActiveAlerts"
                               Text="0"
                               Foreground="#F59E0B"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="COMMANDS ISSUED"
                               Foreground="#8E9AA3"
                               FontSize="11"/>

                    <TextBlock x:Name="LblCommandCount"
                               Text="0"
                               Foreground="#20C997"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Registered devices -->
        <Border Grid.Row="2"
                Background="#171D22"
                BorderBrush="#2B363D"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Device list heading and refresh button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="REGISTERED DEVICES"
                                   Foreground="#20C997"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Devices retrieved from the Smart-X API"
                                   Foreground="#8E9AA3"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="↻ REFRESH"
                            Click="BtnRefreshDevices_Click"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Background="#19362F"
                            Foreground="#20C997"
                            BorderBrush="#245C4D"
                            Cursor="Hand"/>
                </Grid>

                <!-- API connection status -->
                <TextBlock Grid.Row="1"
                           x:Name="LblConnectionStatus"
                           Text="Connecting to the Smart-X API..."
                           Foreground="#8E9AA3"
                           FontSize="12"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"/>

                <!-- Device table -->
                <ListView Grid.Row="2"
                          x:Name="LstDevices"
                          Background="#171D22"
                          Foreground="#F1F5F7"
                          BorderBrush="#2B363D"
                          BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="DEVICE MAC ADDRESS"
                                            Width="220"
                                            DisplayMemberBinding="{Binding DeviceMacAddress}"/>

                            <GridViewColumn Header="CATEGORY"
                                            Width="200"
                                            DisplayMemberBinding="{Binding Category}"/>

                            <GridViewColumn Header="DEPLOYMENT LOCATION"
                                            Width="400"
                                            DisplayMemberBinding="{Binding DeploymentLocation}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Text="SMART-X IOT MANAGEMENT PLATFORM"
                   Foreground="#65717A"
                   FontSize="10"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>