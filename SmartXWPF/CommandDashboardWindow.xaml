<Window x:Class="SmartXWPF.CommandDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | Command Stream and History"
        Height="780"
        Width="1150"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#101418">

    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#20282D"/>
            <Setter Property="Foreground" Value="#8E9AA3"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderBrush" Value="#2B363D"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#20282D"/>
            <Setter Property="Foreground" Value="#8E9AA3"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderBrush" Value="#2B363D"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SMART-X"
                           Foreground="#20C997"
                           FontSize="14"
                           FontWeight="Bold"/>

                <TextBlock Text="Real-Time Command Stream"
                           Foreground="#F1F5F7"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="Manual device control, alerts, recommendations and command history"
                           Foreground="#8E9AA3"
                           FontSize="13"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="‹ MAIN MENU"
                    Click="BtnMainMenu_Click"
                    Padding="16,10"
                    VerticalAlignment="Center"
                    Background="#1D252B"
                    Foreground="#F1F5F7"
                    BorderBrush="#2B363D"
                    Cursor="Hand"/>
        </Grid>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,18">

            <Border Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="REGISTERED DEVICES"
                               Foreground="#8E9AA3"
                               FontSize="11"/>

                    <TextBlock x:Name="LblDeviceCount"
                               Text="—"
                               Foreground="#F1F5F7"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="5,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE ALERTS"
                               Foreground="#8E9AA3"
                               FontSize="11"/>

                    <TextBlock x:Name="LblActiveAlerts"
                               Text="0"
                               Foreground="#F59E0B"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="COMMANDS ISSUED"
                               Foreground="#8E9AA3"
                               FontSize="11"/>

                    <TextBlock x:Name="LblCommandCount"
                               Text="0"
                               Foreground="#20C997"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main dashboard -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>


            <!-- Manual command panel -->
            <Border Grid.Column="0"
        Background="#171D22"
        BorderBrush="#2B363D"
        BorderThickness="1"
        CornerRadius="8"
        Padding="18"
        Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="DEVICE COMMANDS"
                   Foreground="#20C997"
                   FontSize="12"
                   FontWeight="Bold"/>

                    <TextBlock Text="Select any registered device"
                   Foreground="#8E9AA3"
                   FontSize="13"
                   Margin="0,6,0,12"/>

                    <ComboBox x:Name="CmbDevices"
                  SelectionChanged="CmbDevices_SelectionChanged"
                  DisplayMemberPath="DeviceMacAddress"
                  Background="#FFFFFF"
                  Foreground="#1F2937"
                  BorderBrush="#64748B"
                  Padding="8"
                  FontSize="14">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="#1F2937"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#1E3A8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Text="DEPLOYMENT LOCATION"
                   Foreground="#8E9AA3"
                   FontSize="11"
                   Margin="0,16,0,6"/>

                    <TextBlock x:Name="LblSelectedLocation"
                   Text="No device selected"
                   Foreground="#F1F5F7"
                   FontSize="13"
                   TextWrapping="Wrap"/>

                    <TextBlock Text="DEVICE CATEGORY"
                   Foreground="#8E9AA3"
                   FontSize="11"
                   Margin="0,14,0,6"/>

                    <TextBlock x:Name="LblSelectedCategory"
                   Text="—"
                   Foreground="#20C997"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

                    <TextBlock Text="SIMULATED DEVICE STATE"
                   Foreground="#8E9AA3"
                   FontSize="11"
                   Margin="0,20,0,8"/>

                    <TextBlock x:Name="LblDeviceState"
                   Text="Unknown"
                   Foreground="#F59E0B"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

                    <TextBlock Text="AVAILABLE COMMANDS"
                   Foreground="#8E9AA3"
                   FontSize="11"
                   Margin="0,20,0,8"/>

                    <!-- Buttons are populated according to the selected device category. -->
                    <ItemsControl x:Name="ItemsCommandButtons">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                            Click="DynamicCommandButton_Click"
                            MinWidth="105"
                            Height="38"
                            Margin="0,0,8,8"
                            Padding="10,6"
                            Background="#20282D"
                            Foreground="#20C997"
                            BorderBrush="#245C4D"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="BtnUndo"
                Content="↶ UNDO LAST COMMAND"
                Click="BtnUndo_Click"
                Height="38"
                Margin="0,10,0,0"
                Background="#20282D"
                Foreground="#F1F5F7"
                BorderBrush="#20C997"
                BorderThickness="1"
                FontWeight="Bold"
                Cursor="Hand"
                IsEnabled="False"/>

                    <Button Content="REFRESH ALL DATA"
                Click="BtnRefreshAll_Click"
                Height="36"
                Margin="0,14,0,0"
                Background="#20282D"
                Foreground="#F1F5F7"
                BorderBrush="#354149"
                Cursor="Hand"/>

                    <TextBlock x:Name="LblCommandStatus"
                   Text="Select a device to begin."
                   Foreground="#8E9AA3"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0"/>
                </StackPanel>
            </Border>


            <!-- Dashboard tabs -->
            <Border Grid.Column="1"
                    Background="#171D22"
                    BorderBrush="#2B363D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <TabControl Background="#171D22"
                            Foreground="#F1F5F7"
                            BorderBrush="#2B363D">

                    <!-- Registered devices -->
                    <TabItem Header="Devices">
                        <Grid Background="#171D22" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="REGISTERED DEVICES"
                                       Foreground="#20C997"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,8,0,10"/>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="TxtDeviceSearch"
                                         Grid.Row="0"
                                         Grid.Column="0"
                                         Margin="0,0,6,6"
                                         Padding="8"
                                         FontSize="12"
                                         ToolTip="Search by MAC address or deployment location"
                                         TextChanged="TxtDeviceSearch_TextChanged"/>

                                <ComboBox x:Name="CmbCategoryFilter"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="6,0,0,6"
                                          Padding="6"
                                          SelectedIndex="0"
                                          SelectionChanged="CmbCategoryFilter_SelectionChanged">
                                    <ComboBoxItem Content="All Categories"/>
                                    <ComboBoxItem Content="Environmental"/>
                                    <ComboBoxItem Content="PowerConsumption"/>
                                    <ComboBoxItem Content="Actuator"/>
                                </ComboBox>

                                <CheckBox x:Name="ChkActiveAlertsOnly"
                                          Grid.Row="1"
                                          Grid.ColumnSpan="2"
                                          Content="Show only devices with active alerts"
                                          Foreground="#F59E0B"
                                          FontSize="12"
                                          Margin="2,2,0,4"
                                          Checked="ChkActiveAlertsOnly_Changed"
                                          Unchecked="ChkActiveAlertsOnly_Changed"/>
                            </Grid>

                            <ListView Grid.Row="2"
                                      x:Name="LstDevices"
                                      Background="#171D22"
                                      Foreground="#F1F5F7"
                                      BorderBrush="#2B363D"
                                      BorderThickness="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="MAC ADDRESS"
                                                        Width="175"
                                                        DisplayMemberBinding="{Binding DeviceMacAddress}"/>
                                        <GridViewColumn Header="CATEGORY"
                                                        Width="115"
                                                        DisplayMemberBinding="{Binding Category}"/>
                                        <GridViewColumn Header="DEPLOYMENT LOCATION"
                                                        Width="200"
                                                        DisplayMemberBinding="{Binding DeploymentLocation}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Command history -->
                    <TabItem Header="Command History">
                        <Grid Background="#171D22" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="COMMAND HISTORY"
                                       Foreground="#20C997"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,8,0,10"/>

                            <!-- Command history search and filter -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtCommandSearch"
                                         Grid.Column="0"
                                         Margin="0,0,6,0"
                                         Padding="8"
                                         FontSize="12"
                                         ToolTip="Search by device MAC address or command"
                                         TextChanged="TxtCommandSearch_TextChanged"/>

                                <ComboBox x:Name="CmbCommandFilter"
                                          Grid.Column="1"
                                          Margin="6,0,0,0"
                                          Padding="6"
                                          SelectedIndex="0"
                                          SelectionChanged="CmbCommandFilter_SelectionChanged">
                                    <ComboBoxItem Content="All Commands"/>
                                    <ComboBoxItem Content="ON"/>
                                    <ComboBoxItem Content="OFF"/>
                                </ComboBox>
                            </Grid>

                            <ListView Grid.Row="2"
                                      x:Name="LstCommandHistory"
                                      Background="#171D22"
                                      Foreground="#F1F5F7"
                                      BorderBrush="#2B363D"
                                      BorderThickness="1"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="DEVICE"
                                                        Width="145"
                                                        DisplayMemberBinding="{Binding DeviceMacAddress}"/>
                                        <GridViewColumn Header="COMMAND"
                                                        Width="85"
                                                        DisplayMemberBinding="{Binding Command}"/>
                                        <GridViewColumn Header="TIMESTAMP (UTC)"
                                                        Width="175"
                                                        DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                        <GridViewColumn Header="STATUS"
                                                        Width="170"
                                                        DisplayMemberBinding="{Binding Status}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Search history -->
                    <TabItem Header="Search History">
                        <Grid Background="#171D22" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                   Text="OPERATOR SEARCH HISTORY"
                   Foreground="#20C997"
                   FontSize="12"
                   FontWeight="Bold"
                   Margin="0,8,0,10"/>

                            <DataGrid Grid.Row="1"
                  x:Name="DgSearchHistory"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="#171D22"
                  Foreground="#F1F5F7"
                  RowBackground="#171D22"
                  AlternatingRowBackground="#20282D"
                  BorderBrush="#2B363D"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SEARCH AREA"
                                    Binding="{Binding SearchArea}"
                                    Width="140"/>

                                    <DataGridTextColumn Header="SEARCH TERM"
                                    Binding="{Binding SearchTerm}"
                                    Width="*"/>

                                    <DataGridTextColumn Header="TIMESTAMP (LOCAL)"
                                    Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>


                    <!-- Environmental history -->
                    <TabItem Header="Environmental History">
                        <Grid Background="#171D22" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                   Text="ENVIRONMENTAL SENSOR HISTORY"
                   Foreground="#20C997"
                   FontSize="12"
                   FontWeight="Bold"
                   Margin="0,8,0,10"/>

                            <DataGrid Grid.Row="1"
                  x:Name="DgEnvironmentalHistory"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="#171D22"
                  Foreground="#F1F5F7"
                  RowBackground="#171D22"
                  AlternatingRowBackground="#20282D"
                  BorderBrush="#2B363D"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DEVICE MAC"
                                    Binding="{Binding DeviceMacAddress}"
                                    Width="150"/>

                                    <DataGridTextColumn Header="LOCATION"
                                    Binding="{Binding DeploymentLocation}"
                                    Width="160"/>

                                    <DataGridTextColumn Header="TIMESTAMP"
                                    Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="155"/>

                                    <DataGridTextColumn Header="SENSOR VALUE"
                                    Binding="{Binding SensorValue}"
                                    Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Alerts -->
                    <TabItem Header="Alerts">
                        <Grid Background="#171D22" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="ENVIRONMENTAL ALERTS"
                                       Foreground="#20C997"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,8,0,10"/>

                            <DataGrid Grid.Row="1"
                                      x:Name="DgAlerts"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Background="#171D22"
                                      Foreground="#F1F5F7"
                                      RowBackground="#171D22"
                                      AlternatingRowBackground="#20282D"
                                      BorderBrush="#2B363D"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SEVERITY"
                                                        Binding="{Binding Severity}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="READING"
                                                        Binding="{Binding SensorValue}"
                                                        Width="75"/>
                                    <DataGridTextColumn Header="DEVICE"
                                                        Binding="{Binding DeviceMacAddress}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="LOCATION"
                                                        Binding="{Binding DeploymentLocation}"
                                                        Width="170"/>
                                    <DataGridTextColumn Header="MESSAGE"
                                                        Binding="{Binding Message}"
                                                        Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Recommendations -->
                    <TabItem Header="Recommendations">
                        <Grid Background="#171D22" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="PREDICTIVE RECOMMENDATIONS"
                                       Foreground="#20C997"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="0,8,0,10"/>

                            <DataGrid Grid.Row="1"
                                      x:Name="DgRecommendations"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Background="#171D22"
                                      Foreground="#F1F5F7"
                                      RowBackground="#171D22"
                                      AlternatingRowBackground="#20282D"
                                      BorderBrush="#2B363D"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SEVERITY"
                                                        Binding="{Binding Severity}"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="READING"
                                                        Binding="{Binding SensorValue}"
                                                        Width="75"/>
                                    <DataGridTextColumn Header="DEVICE"
                                                        Binding="{Binding DeviceMacAddress}"
                                                        Width="145"/>
                                    <DataGridTextColumn Header="RECOMMENDATION"
                    Binding="{Binding Recommendation}"
                    Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="6"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="RECOMMENDED ACTION"
                    Binding="{Binding RecommendedAction}"
                    Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Padding" Value="6"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Text="SMART-X IOT MANAGEMENT PLATFORM"
                   Foreground="#65717A"
                   FontSize="10"
                   Margin="0,14,0,0"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>