<UserControl x:Class="SmartXWPF.NetworkTopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101418">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#161C20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B363D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#89979F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel>

            <!-- Page heading -->
            <StackPanel Margin="0,0,0,20">

                <TextBlock Text="NETWORK MANAGEMENT"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"/>

                <TextBlock Text="Network Topology &amp; Mesh Routing"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>

                <TextBlock Text="Visualise connected nodes, inspect routes and query historical telemetry."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <!-- Network summary -->
            <UniformGrid Columns="3"
                         Margin="0,0,0,18">

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL NODES"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="LblTotalNodes"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="REACHABLE NODES"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="LblReachableNodes"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#20C997"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="OFFLINE / UNREACHABLE"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="LblOfflineNodes"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#FF7070"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Network topology -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>

                    <TextBlock Text="Mesh Network Topology"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Network connections will be displayed here."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,5,0,12"/>

                    <ComboBox x:Name="CmbTopologyMode"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,10"
                              SelectedIndex="0"
                              SelectionChanged="CmbTopologyMode_SelectionChanged">

                        <ComboBoxItem Content="Full Mesh"/>
                        <ComboBoxItem Content="Minimum Spanning Tree"/>

                    </ComboBox>

                    <Border Background="#101418"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <ScrollViewer Height="500"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      CanContentScroll="False">

                            <Canvas x:Name="NetworkCanvas"
                                    Width="1100"
                                    Height="700"
                                    ClipToBounds="False"/>

                        </ScrollViewer>

                    </Border>

                </StackPanel>
            </Border>

            <!-- Device Management -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>

                    <TextBlock Text="Device Management"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Select a network device and change its online/offline status to simulate a device failure."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,5,0,12"/>

                    <TextBlock Text="Network Device"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbDeviceManagement"
                              Height="36"
                              Padding="8,4"
                              Background="#20282D"
                              Foreground="#101418"
                              DisplayMemberPath="Id"
                              Margin="0,0,0,12"
                    SelectionChanged="CmbDeviceManagement_SelectionChanged"/>

                    <TextBlock x:Name="LblDeviceStatus"
                               Text="Select a device to view its status."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"/>

                    <Button x:Name="BtnToggleDeviceStatus"
                            Content="Take Device Offline"
                            Height="38"
                            Background="#FF7070"
                            Foreground="#101418"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnToggleDeviceStatus_Click"/>

                    <TextBlock x:Name="LblDeviceManagementResult"
                               Text=""
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                </StackPanel>
            </Border>


            <!-- Network traversal -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>

                    <TextBlock Text="Network Traversal"
                   FontSize="16"
                   FontWeight="SemiBold"/>

                    <TextBlock Text="Explore the connected network using Breadth-First Search or Depth-First Search."
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,5,0,12"/>

                    <TextBlock Text="Starting Device"
                   FontWeight="SemiBold"
                   FontSize="11"
                   Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbTraversalStart"
                  Height="36"
                  Padding="8,4"
                  Background="#20282D"
                  Foreground="#101418"
                  DisplayMemberPath="Id"
                  Margin="0,0,0,12"/>

                    <TextBlock Text="Traversal Algorithm"
                   FontWeight="SemiBold"
                   FontSize="11"
                   Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbTraversalAlgorithm"
                  Height="36"
                  Padding="8,4"
                  Background="#20282D"
                  Foreground="#101418"
                  SelectedIndex="0">

                        <ComboBoxItem Content="Breadth-First Search (BFS)"/>
                        <ComboBoxItem Content="Depth-First Search (DFS)"/>

                    </ComboBox>

                    <Button x:Name="BtnRunTraversal"
                Content="Run Network Traversal"
                Height="38"
                Margin="0,12,0,0"
                Background="#20C997"
                Foreground="#101418"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnRunTraversal_Click"/>

                    <TextBlock Text="Traversal Results"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,16,0,6"/>

                    <Border Background="#101418"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">

                        <TextBlock x:Name="LblTraversalResult"
                       Text="Select a starting device and algorithm."
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Sensor routing -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>

                    <TextBlock Text="Sensor Routing"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Select a sensor node to inspect its shortest route to the gateway."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,5,0,12"/>

                    <TextBlock Text="Starting Device"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbRouteDevice"
                              Height="36"
                              Padding="8,4"
                              Background="#20282D"
                              Foreground="#101418"
                              DisplayMemberPath="Id"/>

                    <Button x:Name="BtnFindRoute"
                            Content="Find Route to Gateway"
                            Height="38"
                            Margin="0,12,0,0"
                            Background="#20C997"
                            Foreground="#101418"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnFindRoute_Click"/>

                    <TextBlock Text="Calculated Route"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6"/>

                    <TextBlock x:Name="LblRouteResult"
                               Text="Select a sensor to calculate its route."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- Historical telemetry -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Margin="0">

                <StackPanel>

                    <TextBlock Text="Historical Telemetry"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Query a registered sensor's historical readings by timestamp."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,5,0,12"/>

                    <TextBlock Text="Registered Sensor MAC Address"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbSensor"
                              Height="36"
                              Padding="8,4"
                              Background="#20282D"
                              Foreground="#101418"
                              DisplayMemberPath="DeviceMacAddress"
                              Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,6,0">

                            <TextBlock Text="Start Time"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>

                            <DatePicker x:Name="DpStartDate"
                                        SelectedDateFormat="Short"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="6,0,0,0">

                            <TextBlock Text="End Time"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>

                            <DatePicker x:Name="DpEndDate"
                                        SelectedDateFormat="Short"/>

                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnQueryHistory"
                            Content="Query Historical Readings"
                            Height="36"
                            Margin="0,12,0,12"
                            Background="#20282D"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Cursor="Hand"
                            Click="BtnQueryHistory_Click"/>

                    <DataGrid x:Name="DgTelemetryHistory"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="150"
                              Background="#161C20"
                              Foreground="#F1F5F7"
                              BorderBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="#161C20"/>
                                <Setter Property="Foreground"
                                        Value="#F1F5F7"/>
                                <Setter Property="BorderBrush"
                                        Value="#2B363D"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background"
                                        Value="#161C20"/>
                                <Setter Property="Foreground"
                                        Value="#F1F5F7"/>
                                <Setter Property="BorderBrush"
                                        Value="#2B363D"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#20282D"/>
                                <Setter Property="Foreground"
                                        Value="#20C997"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Padding"
                                        Value="8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Sensor MAC"
                                                Binding="{Binding DeviceMacAddress}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding SensorValue}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding DeploymentLocation}"
                                                Width="2*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <TextBlock x:Name="LblHistoryStatus"
                               Text="No historical readings loaded."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,10,0,0"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
