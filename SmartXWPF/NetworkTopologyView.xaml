<UserControl x:Class="SmartXWPF.NetworkTopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101418">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#161C20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B363D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#89979F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Page heading -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="NETWORK MANAGEMENT"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"/>

                <TextBlock Text="Network Topology &amp; Mesh Routing"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>

                <TextBlock Text="Visualise connected nodes, inspect routes and query historical telemetry."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Network summary -->
            <UniformGrid Columns="3" Margin="0,0,0,18">

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL NODES"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LblTotalNodes"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="REACHABLE NODES"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LblReachableNodes"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#20C997"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="OFFLINE / UNREACHABLE"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LblOfflineNodes"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#FF7070"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Network topology -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Mesh Network Topology"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Network connections will be displayed here."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,5,0,12"/>

                    <Border Background="#101418"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="260">

                        <Canvas x:Name="NetworkCanvas"
                                Height="260"
                                ClipToBounds="True"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sensor selection and route -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Sensor Routing"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Select a sensor to inspect its route to the gateway."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,5,0,12"/>

                    <TextBlock Text="Sensor MAC Address"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="CmbSensor"
                              Height="36"
                              Padding="8,4"
                              Background="#20282D"
                              Foreground="#101418"/>

                    <Button x:Name="BtnFindRoute"
                            Content="Find Route to Gateway"
                            Height="38"
                            Margin="0,12,0,0"
                            Background="#20C997"
                            Foreground="#101418"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnFindRoute_Click"/>

                    <TextBlock Text="Calculated Route"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6"/>

                    <TextBlock x:Name="LblRouteResult"
                               Text="Select a sensor to calculate its route."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Historical telemetry -->
            <Border Style="{StaticResource SectionCardStyle}"
                    Margin="0">
                <StackPanel>
                    <TextBlock Text="Historical Telemetry"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Query a sensor's historical readings by timestamp."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,5,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Start Time"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>

                            <DatePicker x:Name="DpStartDate"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="End Time"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>

                            <DatePicker x:Name="DpEndDate"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnQueryHistory"
                            Content="Query Historical Readings"
                            Height="36"
                            Margin="0,12,0,12"
                            Background="#20282D"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            Cursor="Hand"
                            Click="BtnQueryHistory_Click"/>

                    <DataGrid x:Name="DgTelemetryHistory"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="150"
                              Background="#161C20"
                              Foreground="#F1F5F7"
                              BorderBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#161C20"/>
                                <Setter Property="Foreground" Value="#F1F5F7"/>
                                <Setter Property="BorderBrush" Value="#2B363D"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#161C20"/>
                                <Setter Property="Foreground" Value="#F1F5F7"/>
                                <Setter Property="BorderBrush" Value="#2B363D"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#20282D"/>
                                <Setter Property="Foreground" Value="#20C997"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Sensor MAC"
                                                Binding="{Binding DeviceMacAddress}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding SensorValue}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding DeploymentLocation}"
                                                Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="LblHistoryStatus"
                               Text="No historical readings loaded."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>