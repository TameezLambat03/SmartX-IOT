<Window x:Class="SmartXWPF.SensorDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X Ingestion Dashboard" Height="650" Width="900" Background="#181818">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Sensor Registration" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,15"/>

            <TextBlock Text="Device MAC Address / Node ID" Foreground="#CCCCCC" Margin="0,5,0,2"/>
            <TextBox x:Name="TxtMacAddress" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="5" Text="00:1B:44:11:3A:B7"/>

            <TextBlock Text="Deployment Hierarchy (Path)" Foreground="#CCCCCC" Margin="0,10,0,2"/>
            <TextBox x:Name="TxtDeploymentPath" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="5" Text="Facility A/Zone 1/Sub-Zone B"/>

            <TextBlock Text="Sensor Category" Foreground="#CCCCCC" Margin="0,10,0,2"/>
            <ComboBox x:Name="CmbCategory" Height="30" Background="#2D2D30" Foreground="White" SelectedIndex="0" Margin="0,0,0,10">
                <ComboBoxItem Content="Environmental (Soil Moisture / Temp)"/>
                <ComboBoxItem Content="Power Consumption (Smart Meter)"/>
                <ComboBoxItem Content="Actuator (Valve State)"/>
            </ComboBox>

            <TextBlock Text="Sensor Reading / Metric Value" Foreground="#CCCCCC" Margin="0,5,0,2"/>
            <TextBox x:Name="TxtSensorValue" Height="30" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" Padding="5" Text="45.5"/>

            <Button x:Name="BtnAttachFile" Content="Attach Device Configuration / Log File" Height="35" Margin="0,15,0,5" Background="#333337" Foreground="White" Click="BtnAttachFile_Click"/>
            <TextBlock x:Name="LblAttachedFile" Text="No file attached" Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>

            <Button x:Name="BtnSubmitTelemetry" Content="Push Telemetry &amp; Validate" Height="40" Margin="0,20,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnSubmitTelemetry_Click"/>
            <Button x:Name="BtnSimulateAggregation" Content="Simulate Overloaded Operator (+)" Height="35" Margin="0,10,0,0" Background="#5C2D91" Foreground="White" Click="BtnSimulateAggregation_Click"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#252526" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Real-Time Telemetry Monitor" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Visual anomaly detection and live gateway ingestion log" Foreground="#AAAAAA" FontSize="12"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtTelemetryFeed" Foreground="#00FF66" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="Gateway online. Ready to ingest telemetry data...&#x0a;"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="LblStatusIndicator" Text="STATUS: NORMAL" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" x:Name="LblAnomalyAlert" Text="No Anomalies Detected" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>