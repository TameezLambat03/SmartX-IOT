<Window x:Class="SmartXWPF.SensorDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | Telemetry Gateway"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        Background="#101418"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#101418"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171D22"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1D252B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B363D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8E9AA3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#11171B"/>
            <Setter Property="Foreground" Value="#F1F5F7"/>
            <Setter Property="BorderBrush" Value="#2B363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#20C997"/>
            <Setter Property="Foreground" Value="#07110E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#202930"/>
            <Setter Property="Foreground" Value="#DCE4E8"/>
            <Setter Property="BorderBrush" Value="#34414A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E9AA3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,5"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="SMART-X"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>

                <TextBlock Text="IoT Management &amp; Telemetry Gateway"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#14251F"
                    BorderBrush="#214C3F"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="12,7">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,8,0"/>

                    <TextBlock x:Name="LblGatewayStatus"
                               Text="CONNECTING..."
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- SUMMARY CARDS -->

        <Grid Grid.Row="1" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="15"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="REGISTERED DEVICES"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="LblDeviceCount"
                               Text="0"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Sensor profiles"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="15"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="TELEMETRY PACKETS"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="LblPacketCount"
                               Text="0"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Processed by gateway"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="15"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="SYSTEM STATUS"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="LblSystemStatus"
                               Text="NORMAL"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Monitoring active"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"/>
                </StackPanel>

            </Border>

        </Grid>

        <!-- MAIN -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- REGISTER -->

                        <TextBlock Text="REGISTER SENSOR"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Create a sensor profile before sending telemetry."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="DEVICE MAC ADDRESS / NODE ID"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="TxtMacAddress"
                                 Style="{StaticResource InputStyle}"
                                 Text="00:1B:44:11:3A:B7"/>

                        <TextBlock Text="DEPLOYMENT HIERARCHY"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="TxtDeploymentPath"
                                 Style="{StaticResource InputStyle}"
                                 Text="Facility A/Zone 1/Sub-Zone B"/>

                        <TextBlock Text="Example: Facility / Zone / Sub-Zone"
                                   Foreground="#66737C"
                                   FontSize="9"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="SENSOR CATEGORY"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="CmbCategory"
                                  Height="38"
                                  SelectedIndex="0"
                                  Background="#11171B"
                                  Foreground="#11171B"
                                  BorderBrush="#2B363D"
                                  SelectionChanged="CmbCategory_SelectionChanged">

                            <ComboBoxItem Content="Environmental"/>
                            <ComboBoxItem Content="Power Consumption"/>
                            <ComboBoxItem Content="Actuator"/>

                        </ComboBox>

                        <Button x:Name="BtnRegisterSensor"
                                Content="REGISTER SENSOR PROFILE"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,18,0,0"
                                Click="BtnRegisterSensor_Click"/>

                        <!-- REGISTERED SENSORS -->

                        <TextBlock Text="REGISTERED SENSORS"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,22,0,4"/>

                        <TextBlock x:Name="LblSensorCount"
                                   Text="0 registered sensor(s)"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="LstSensors"
                                 Height="150"
                                 Background="#11171B"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="#2B363D"
                                 BorderThickness="1"
                                 SelectionChanged="LstSensors_SelectionChanged">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border Padding="8"
                                            BorderBrush="#263139"
                                            BorderThickness="0,0,0,1">

                                        <StackPanel>

                                            <TextBlock Text="{Binding DeviceMacAddress}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="11"/>

                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0"/>

                                            <TextBlock Text="{Binding DeploymentLocation}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <Button x:Name="BtnRefreshSensors"
                                Content="REFRESH SENSOR LIST"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnRefreshSensors_Click"
                                Margin="0,8,0,0"/>

                        <!-- SELECTED SENSOR -->

                        <TextBlock Text="SELECTED SENSOR"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,20,0,4"/>

                        <Border Background="#11171B"
                                BorderBrush="#2B363D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">

                            <StackPanel>

                                <TextBlock Text="MAC ADDRESS"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="LblSelectedSensorMac"
                                           Text="No sensor selected"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="11"
                                           Margin="0,3,0,7"/>

                                <TextBlock Text="CATEGORY"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="LblSelectedSensorCategory"
                                           Text="—"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           Margin="0,3,0,7"/>

                                <TextBlock Text="DEPLOYMENT"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="LblSelectedSensorLocation"
                                           Text="—"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>

                                  

                            </StackPanel>

                        </Border>

                        <!-- TELEMETRY -->

                        <TextBlock Text="SEND TELEMETRY"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,20,0,4"/>

                        <TextBlock Text="Telemetry is sent using the selected registered sensor."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="SENSOR VALUE"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="TxtSensorValue"
                                 Style="{StaticResource InputStyle}"
                                 Text="45.5"/>

                        <ComboBox x:Name="CmbActuatorState"
                                  Height="38"
                                  SelectedIndex="0"
                                  Background="#11171B"
                                  Foreground="#11171B"
                                  BorderBrush="#2B363D"
                                  Visibility="Collapsed">

                            <ComboBoxItem Content="ON"/>
                            <ComboBoxItem Content="OFF"/>

                        </ComboBox>

                        <Button x:Name="BtnSubmitTelemetry"
                                Content="PUSH TELEMETRY"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,8,0,0"
                                Click="BtnSubmitTelemetry_Click"/>

                        <Button x:Name="BtnSeedTelemetry"
                                Content="SEED MOCK TELEMETRY"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,8,0,0"
                                Click="BtnSeedTelemetry_Click"/>

                        <!-- ATTACHMENT -->

                        <TextBlock Text="DEVICE ARTIFACT"
           Style="{StaticResource FieldLabelStyle}"
           Margin="0,20,0,5"/>

                        <Button x:Name="BtnAttachFile"
        Content="ATTACH CONFIG / LOG / PHOTO"
        Style="{StaticResource SecondaryButtonStyle}"
        Click="BtnAttachFile_Click"/>

                        <TextBlock x:Name="LblAttachedFile"
           Text="No file attached"
           Foreground="{StaticResource MutedTextBrush}"
           FontSize="10"
           TextWrapping="Wrap"
           Margin="0,6,0,0"/>

                        <!-- DEVELOPER TOOLS -->

                        <TextBlock Text="DEVELOPER TESTING"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,20,0,5"/>

                        <Button x:Name="BtnSimulateAggregation"
                                Content="SIMULATE AGGREGATION (+)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnSimulateAggregation_Click"/>

                        <Button x:Name="BtnFetchTelemetry"
                                Content="RETRIEVE HISTORY"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,8,0,0"
                                Click="BtnFetchTelemetry_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- RIGHT PANEL -->

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="10,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MONITOR HEADER -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock Text="LIVE TELEMETRY MONITOR"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"/>

                            <TextBlock Text="Real-time gateway ingestion and anomaly feedback"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"/>

                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                Background="#18241F"
                                BorderBrush="#214C3F"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="9,5">

                            <TextBlock Text="● STREAM ACTIVE"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>

                        </Border>

                    </Grid>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CURRENT READING -->

                        <Border Grid.Row="0"
                                Background="#11171B"
                                BorderBrush="#2B363D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="CURRENT TELEMETRY"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="LblCurrentReading"
                                               Text="--"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Margin="0,3,0,0"/>

                                    <TextBlock x:Name="LblReadingCategory"
                                               Text="Waiting for telemetry..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="LAST UPDATE"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="LblLastUpdate"
                                               Text="--:--:--"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- CHART -->

                        <Border Grid.Row="1"
                                Background="#0E1316"
                                BorderBrush="#263139"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,10">

                            <Grid>

                                <TextBlock Text="TELEMETRY TREND"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>

                                <Canvas x:Name="TelemetryChartCanvas"
                                        Margin="0,20,0,0"
                                        Background="#11171B"
                                        ClipToBounds="True"/>

                            </Grid>

                        </Border>

                        <!-- FEED -->

                        <Border Grid.Row="2"
                                Background="#0E1316"
                                BorderBrush="#263139"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <TextBlock x:Name="TxtTelemetryFeed"
                                           Foreground="#8FF0C8"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Gateway online.&#x0a;Telemetry ingestion pipeline ready.&#x0a;Waiting for sensor data...&#x0a;"/>

                            </ScrollViewer>

                        </Border>

                    </Grid>

                    <!-- STATUS -->

                    <Border Grid.Row="2"
                            Background="#11171B"
                            BorderBrush="#2B363D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock x:Name="LblStatusIndicator"
                                           Text="● STATUS: NORMAL"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12"/>

                                <TextBlock Text="Gateway telemetry is currently within the configured baseline."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <TextBlock x:Name="LblAnomalyAlert"
                                       Grid.Column="1"
                                       Text="NO ANOMALIES DETECTED"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>