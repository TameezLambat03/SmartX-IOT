<Window x:Class="SmartXWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | Authentication"
        Height="580"
        Width="920"
        MinHeight="540"
        MinWidth="800"
        Background="#101418"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#101418"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161C20"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1B2328"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B363D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#89979F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997"/>
        <SolidColorBrush x:Key="AccentPanelBrush" Color="#19362F"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#101418"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#101418"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#19362F"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#245C4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20483D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1B2328"/>
            <Setter Property="BorderBrush" Value="#2B363D"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- BRAND PANEL -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="SMART-X"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="15"
                           FontWeight="Bold"/>

                <TextBlock Text="IoT Ecosystem Gateway"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           Margin="0,5,0,0"/>

                <Border Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,22,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">
                <Border Width="54"
                        Height="54"
                        CornerRadius="7"
                        Background="{StaticResource AccentPanelBrush}"
                        BorderBrush="#245C4D"
                        BorderThickness="1"
                        HorizontalAlignment="Left">
                    <TextBlock Text="SX"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Gateway&#x0a;Management"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="34"
                           FontWeight="Bold"
                           LineHeight="40"
                           Margin="0,22,0,0"/>

                <TextBlock Text="Integrated sensor telemetry and device command management."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="13"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"
                           MaxWidth="330"/>

                <StackPanel Margin="0,28,0,0">
                    <TextBlock Text="01   SENSOR TELEMETRY"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,13"/>

                    <TextBlock Text="02   DEVICE COMMANDS"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,13"/>

                    <TextBlock Text="03   NETWORK MONITORING"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="SMART-X IoT MANAGEMENT PLATFORM"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="9"
                       FontWeight="Bold"/>
        </Grid>

        <!-- LOGIN PANEL -->
        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="30">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border HorizontalAlignment="Left"
        CornerRadius="10"
        Background="#16352D"
        BorderBrush="#245C4D"
        BorderThickness="1"
                            Padding="9,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="9"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="AUTHENTICATION"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Welcome back"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,22,0,0"/>

                    <TextBlock Text="Sign in to access the Smart-X gateway."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            Margin="0,15,0,15">

                    <TextBlock Text="EMAIL ADDRESS"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="PASSWORD"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,20,0,8"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Style="{StaticResource PasswordInputStyle}"/>

                    <Button Content="SIGN IN  →"
                            Click="LoginButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,24,0,0"/>

                    <Button Content="CREATE ACCOUNT"
                            Click="RegisterButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,0,14"/>

                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="SMART-X  /  SECURE ACCESS"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
