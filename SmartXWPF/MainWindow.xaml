<Window x:Class="SmartXWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | IoT Gateway"
        Height="650"
        Width="1050"
        MinHeight="600"
        MinWidth="900"
        Background="#101418"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#101418"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161C20"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1B2328"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B363D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#89979F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997"/>
        <SolidColorBrush x:Key="DisabledBrush" Color="#59656C"/>

        <!-- Active Pill -->
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#16352D"/>
            <Setter Property="BorderBrush" Value="#245C4D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Main Active Button -->
        <Style x:Key="ActiveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="#19362F"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#245C4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disabled Button -->
        <Style x:Key="DisabledButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActiveButtonStyle}">

            <Setter Property="Background" Value="#151A1D"/>
            <Setter Property="BorderBrush" Value="#252D32"/>
            <Setter Property="Foreground" Value="{StaticResource DisabledBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

    </Window.Resources>


    <Grid Margin="34">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Grid Grid.Row="0">

            <StackPanel>

                <TextBlock Text="SMART-X"
           FontSize="16"
           FontWeight="Bold"
           Foreground="{StaticResource AccentBrush}"/>

                <TextBlock Text="IoT Ecosystem Gateway"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,5,0,0"/>

                <TextBlock Text="Integrated sensor telemetry and gateway management"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Gateway status -->

            <Border Style="{StaticResource StatusPillStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="●"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <TextBlock Text="GATEWAY ONLINE"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================= SPACING ================= -->

        <Border Grid.Row="1"
                Background="Transparent"/>


        <!-- ================= ARCHITECTURE CARDS ================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- SENSOR TELEMETRY -->

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#245C4D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0">

                        <Border Width="42"
                                Height="42"
                                CornerRadius="6"
                                Background="#19362F"
                                HorizontalAlignment="Left">

                            <TextBlock Text="01"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="Sensor Data Ingestion"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Telemetry"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <TextBlock Grid.Row="1"
                               Text="Receive, process and visualize sensor telemetry from the Smart-X IoT ecosystem. Supports environmental, power and actuator data."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               VerticalAlignment="Top"
                               Margin="0,18,0,20"/>


                    <Button Grid.Row="2"
                            x:Name="BtnIngestion"
                            Content="OPEN TELEMETRY DASHBOARD  ›"
                            Click="BtnIngestion_Click"
                            Style="{StaticResource ActiveButtonStyle}"/>

                </Grid>

            </Border>


            <!-- COMMAND STREAM -->

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0">

                        <Border Width="42"
                                Height="42"
                                CornerRadius="6"
                                Background="#222A2F"
                                HorizontalAlignment="Left">

                            <TextBlock Text="02"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="Real-Time Command"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Stream &amp; History"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <TextBlock Grid.Row="1"
                               Text="Command streaming, actuator control and command history will be introduced in the next development stage."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               VerticalAlignment="Top"
                               Margin="0,18,0,20"/>


                    <Button Grid.Row="2"
                            Content="COMING SOON"
                            IsEnabled="False"
                            Style="{StaticResource DisabledButtonStyle}" Click="Button_Click"/>

                </Grid>

            </Border>


            <!-- NETWORK TOPOLOGY -->

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0">

                        <Border Width="42"
                                Height="42"
                                CornerRadius="6"
                                Background="#222A2F"
                                HorizontalAlignment="Left">

                            <TextBlock Text="03"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="Network Topology"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,16,0,0"/>

                        <TextBlock Text="Mesh Routing"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <TextBlock Grid.Row="1"
                               Text="Visualize device relationships, mesh connectivity and routing paths across the Smart-X deployment network."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               VerticalAlignment="Top"
                               Margin="0,18,0,20"/>


                    <Button Grid.Row="2"
                            Content="COMING SOON"
                            IsEnabled="False"
                            Style="{StaticResource DisabledButtonStyle}"/>

                </Grid>

            </Border>

        </Grid>


        <!-- ================= FOOTER ================= -->

        <Grid Grid.Row="3"
              Margin="0,22,0,0">

            <TextBlock Text="SMART-X IoT MANAGEMENT PLATFORM"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="9"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <TextBlock Text="ARCHITECTURE STATUS: 1 / 3 ACTIVE"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="9"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>