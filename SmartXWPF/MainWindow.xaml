<Window x:Class="SmartXWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | IoT Gateway"
        Height="760"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        Background="#101418"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#101418"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161C20"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B363D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#89979F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20C997"/>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#161C20"/>
            <Setter Property="Foreground" Value="#B7C1C7"/>
            <Setter Property="BorderBrush" Value="#2B363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisabledNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavigationButtonStyle}">
            <Setter Property="Foreground" Value="#59656C"/>
            <Setter Property="Background" Value="#12171A"/>
            <Setter Property="BorderBrush" Value="#252D32"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent navigation sidebar -->
        <Border Grid.Column="0"
                Background="#13191D"
                BorderBrush="#2B363D"
                BorderThickness="0,0,1,0"
                Padding="20">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SMART-X"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <TextBlock Text="IoT ECOSYSTEM GATEWAY"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,30"/>

                    <TextBlock Text="WORKSPACE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,0,8"/>

                    <Button x:Name="BtnIngestion"
                            Content="01   Sensor Telemetry"
                            Click="BtnIngestion_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>

                    <Button x:Name="BtnCommandDashboard"
                            Content="02   Command Stream"
                            Click="BtnCommandDashboard_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>

                    <Button Content="03   Network Topology"
                            IsEnabled="False"
                            Style="{StaticResource DisabledNavigationButtonStyle}"/>

                    <Border Height="1"
                            Background="#2B363D"
                            Margin="0,24,0,18"/>

                    <TextBlock Text="PLATFORM STATUS"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="●"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Gateway Online"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <Border Height="1"
                            Background="#2B363D"
                            Margin="0,0,0,14"/>

                    <TextBlock Text="SMART-X"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <TextBlock Text="IoT Management Platform"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="SMART-X WORKSPACE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <TextBlock Text="IoT Ecosystem Gateway"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Manage telemetry, devices and real-time commands."
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#16352D"
                        BorderBrush="#245C4D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="GATEWAY ONLINE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">

                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
